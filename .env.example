# Optional. Server-side GitHub token used when a visitor hasn't supplied their own.
# Raises the GitHub API limit from 60 to 5,000 requests/hour. For safety, RepoMap
# only serves PUBLIC repositories with this token; private repos require the
# visitor's own token.
GITHUB_TOKEN=

# Turns on AI summaries and the project overview. Never sent to the browser.
# Without it the map, entry points and file details still work; AI features show as off.
ANTHROPIC_API_KEY=

# Optional. Claude model for summaries and the overview (default: claude-opus-5-5).
# Changing it regenerates cached summaries, since the model is part of the cache key.
REPOMAP_AI_MODEL=

# Local development only: set to 1 to stream placeholder "[Mock]" summaries without
# an API key, to work on the UI. Never set this in production.
REPOMAP_AI_MOCK=

# Where the local file cache lives (default: .cache/repomap).
REPOMAP_CACHE_DIR=
