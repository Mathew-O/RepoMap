# Optional. Server-side GitHub token used when a visitor hasn't supplied their own.
# Raises the GitHub API limit from 60 to 5,000 requests/hour. For safety, RepoMap
# only serves PUBLIC repositories with this token; private repos require the
# visitor's own token.
GITHUB_TOKEN=

# Milestone 4 (AI summaries). Never exposed to the browser.
ANTHROPIC_API_KEY=

# Where the local file cache lives (default: .cache/repomap).
REPOMAP_CACHE_DIR=
